    "AirLift needs a pairing record and none is stored. Import one on the home page.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AirLift 需要配对记录，但尚未存储。请在首页导入一个。"
