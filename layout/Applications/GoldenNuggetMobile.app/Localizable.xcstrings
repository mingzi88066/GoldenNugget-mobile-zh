{
  "sourceLanguage": "en",
  "strings": {
    "%@  •  %@  •  %@  •  iOS %@  •  %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@  •  %2$@  •  %3$@  •  iOS %4$@  •  %5$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  •  %@  •  %@  •  iOS %@  •  %@"
          }
        }
      }
    },
    "%@ (%lld/%lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$lld/%3$lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%lld/%lld）"
          }
        }
      }
    },
    "%@ (%llu KB)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$llu KB)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%llu KB）"
          }
        }
      }
    },
    "%@ has nothing in it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是空的。"
          }
        }
      }
    },
    "%@ on the device, removed with no trash and no undo.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（位于设备上），删除后没有回收站，也无法撤销。"
          }
        }
      }
    },
    "%@ uses the legacy %@ format.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ uses the legacy %2$@ format."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 使用旧版 %@ 格式。"
          }
        }
      }
    },
    "%@ will be copied into this app's container. Free space there: %@. Once removed, the copy in the container is the only one -- and the container is deleted if the app is.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%@ will be copied into this app's container. Free space there: %@. Once removed, the copy in the container is the only one -- and the container is deleted if the app is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将被复制到本 App 的容器中。容器可用空间：%@。删除后容器内的副本是唯一一份，而卸载 App 时容器也会被删除。"
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        }
      }
    },
    "%@ — %lld file(s), %lld key(s) found.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ — %2$lld file(s), %3$lld key(s) found."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 找到 %lld 个文件、%lld 个键。"
          }
        }
      }
    },
    "%lld file(s), %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld file(s), %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个文件，%@"
          }
        }
      }
    },
    "%lld files": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个文件"
          }
        }
      }
    },
    "%lld of %lld applicable tweak(s) enabled. Incompatible and un-ported tweaks are hidden, the same way the reference hides them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld applicable tweak(s) enabled. Incompatible and un-ported tweaks are hidden, the same way the reference hides them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用 %lld/%lld 个可用插件。不兼容与未移植的插件已隐藏，与参考实现一致。"
          }
        }
      }
    },
    "%lld of %lld daemon group(s) on. The groups upstream marks interface-visible but gives no switch are in the Recommended set only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld daemon group(s) on. The groups upstream marks interface-visible but gives no switch are in the Recommended set only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开启 %lld/%lld 个守护进程组。上游标记为界面可见但未提供开关的组仅出现在“推荐”集合中。"
          }
        }
      }
    },
    "%lld operations found": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到 %lld 个操作"
          }
        }
      }
    },
    "%lld override(s) → %@, written on the next Apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld override(s) → %2$@, written on the next Apply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项覆盖 → %@，将在下次应用时写入。"
          }
        }
      }
    },
    "%lld photo(s) and video(s) — %@ kept in the app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld photo(s) and video(s) — %2$@ kept in the app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张照片与视频 — %@ 保留在 App 内"
          }
        }
      }
    },
    "(empty = clear)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（留空 = 清除）"
          }
        }
      }
    },
    ", %lld symlink(s) skipped": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，跳过 %lld 个符号链接"
          }
        }
      }
    },
    "1 file": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个文件"
          }
        }
      }
    },
    "1 · Tunnel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · 隧道"
          }
        }
      }
    },
    "1. SysSharedContainerDomain-systemgroup.com.apple.configurationprofiles/Library/ConfigurationProfiles/CloudConfigurationDetails.plist, %lld setup panes marked skipped;": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. SysSharedContainerDomain-systemgroup.com.apple.configurationprofiles/Library/ConfigurationProfiles/CloudConfigurationDetails.plist，%lld 个设置面板标记为跳过；"
          }
        }
      }
    },
    "2 · Pairing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2 · 配对"
          }
        }
      }
    },
    "2. ManagedPreferencesDomain/mobile/com.apple.purplebuddy.plist, setup marked done.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. ManagedPreferencesDomain/mobile/com.apple.purplebuddy.plist，设置标记为完成。"
          }
        }
      }
    },
    "A folder. Nothing goes through a trash here — this is the device's own delete.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹。此处不经过废纸篓 — 这是设备自身的删除操作。"
          }
        }
      }
    },
    "A video that carries a rotation transform is decoded in its stored orientation, which is what the reference's decoder does; such a clip may appear rotated on the Lock Screen.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带旋转信息的视频会按其存储方向解码，这与参考解码器的行为一致；此类片段在锁屏上可能显示为旋转状态。"
          }
        }
      }
    },
    "A wallpaper exists in two places at once — its descriptor files, and three rows in the store's own sqlite. The rows carry the device's provider registrations and the metadata the picker sorts by, so they cannot be invented: the apply fetches the store from the device first and adds rows to a copy of it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "壁纸同时存在于两处——描述文件，以及存储自身 sqlite 中的三行记录。这些记录携带设备的提供方注册信息与选择器排序所用的元数据，无法凭空构造：应用时会先从设备取出该存储，再在副本中追加记录。"
          }
        }
      }
    },
    "AAR handling": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AAR 处理"
          }
        }
      }
    },
    "AFC media": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AFC 媒体"
          }
        }
      }
    },
